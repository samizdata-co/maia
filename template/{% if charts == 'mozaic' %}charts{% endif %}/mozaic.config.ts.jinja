import type { LocaleCode } from '@samizdata/mozaic/locale';

/** Project settings. Charts are registered in src/charts/index.ts; the house style is src/lib/theme.ts. */
export const config = {
	/** Used in URLs and file names. */
	project: '{{ project_slug }}',
	title: '{{ project_name }}',
	/** Languages to build. The first is the default. */
	locales: [{% for locale in chart_locales.split(',') %}'{{ locale.strip() }}'{% if not loop.last %}, {% endif %}{% endfor %}] as LocaleCode[],
	/**
	 * Public URL where `output/charts/build/` will be deployed, with a trailing slash, e.g.
	 * `https://charts.example.com/{{ project_slug }}/`. Used for embed codes.{% if outlet == 'zdg' %}
	 * `pnpm upload` publishes the build here, through the grafice repo.{% endif %}
	 */
	baseUrl: '{% if outlet == 'zdg' %}{{ grafice_url }}{{ project_slug }}/{% endif %}',
	/**
	 * Social media images (`pnpm social`, the social-images skill). `widths`: chart widths in px that fit a
	 * format better than the automatic choice, per chart and format, e.g. `{ prices: { landscape: 800 } }`.
	 */
	social: {
		widths: {} as Record<string, Record<string, number>>
	}
};
